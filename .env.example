# ===== LLM（供应商无关：任意 OpenAI 兼容大模型，改这三行即可换供应商）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
# 模型名必填，如 gpt-4o / qwen-max / glm-4.x / deepseek-chat 等
LLM_MODEL=
LLM_TEMPERATURE=0.3

# ===== FRED 宏观数据（https://fred.stlouisfed.org 注册免费 key）=====
FRED_API_KEY=

# ===== 运行模式：true = 全链路 mock 数据（无网无 key 验证系统）=====
MOCK_MODE=false

# ===== MySQL 8 连接 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ticker_copilot

# ===== 缓存目录（相对项目根）=====
CACHE_DIR=data/cache

# ===== X 爬虫 =====
X_STORAGE_STATE_PATH=data/x_state/state.json
MAX_X_BLOGGERS_PER_RUN=5
X_POST_HOURS_BACK=48

# ===== 新闻源（逗号分隔 RSS；留空使用内置默认源，可追加）=====
NEWS_RSS_FEEDS=

# ===== 调度 =====
# 事件轮询 + 收盘分析调度总开关（准实时跟进）
SCHEDULER_ENABLED=true
# 事件管道轮询间隔（分钟，15~30）
EVENT_POLL_INTERVAL_MIN=20
# 新事件到达发 macOS 系统通知（osascript，零依赖）
NEW_EVENT_NOTIFY=false
